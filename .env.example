# 사람인 오픈API 키 (https://oapi.saramin.co.kr)
SARAMIN_API_KEY=
# 사용할 모델 ("제공자:모델"). 이 한 줄만 바꾸면 모델이 바뀝니다.
#   Gemini(무료 구간): google_genai:gemini-2.5-flash
#   Claude(유료):      anthropic:claude-sonnet-5-5  (pip install langchain-anthropic 필요)
LLM_MODEL=google_genai:gemini-2.5-flash
# Gemini 키 (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# Claude를 쓸 때만 입력
ANTHROPIC_API_KEY=
# 구글 서비스 계정 키 파일 경로
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# 저장할 구글 시트 ID (시트 주소의 /d/ 와 /edit 사이 문자열)
GOOGLE_SHEET_ID=1fTAXpz1nEaTx8216MFGWO4eUDAWjDhRMrSatpd8P13E
